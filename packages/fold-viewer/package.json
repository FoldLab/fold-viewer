{
  "name": "@foldlab/fold-viewer",
  "version": "0.1.0",
  "description": "Composable React components for viewing Fold Spec documents.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.2 <20",
    "react-dom": ">=18.2 <20",
    "three": "^0.180.0"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FoldLab/fold-viewer.git",
    "directory": "packages/fold-viewer"
  },
  "homepage": "https://foldlab.github.io/fold-viewer/",
  "bugs": {
    "url": "https://github.com/FoldLab/fold-viewer/issues"
  },
  "keywords": [
    "origami",
    "fold-spec",
    "react",
    "three.js",
    "viewer"
  ]
}

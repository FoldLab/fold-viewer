{
  "name": "fold-viewer-workspace",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @foldlab/fold-viewer && npm run build -w @foldlab/fold-viewer-demo",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run registry:check && npm run package:check",
    "dev": "npm run dev -w @foldlab/fold-viewer-demo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:check": "node scripts/check-package.mjs",
    "package:consumers": "node scripts/check-consumers.mjs",
    "registry:check": "shadcn build registry.json -o node_modules/.cache/fold-viewer-registry",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p packages/fold-viewer/tsconfig.json --pretty false && tsc -p apps/demo/tsconfig.json --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "eslint-plugin-react-refresh": "^0.4.21",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shadcn": "^4.21.0",
    "three": "^0.180.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^5.0.1"
  }
}
